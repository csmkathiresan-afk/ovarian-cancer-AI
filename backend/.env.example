# Copy this file to .env and fill in local values.
# Never commit real Wi-Fi passwords or production secrets.

APP_NAME=Ovarian Cancer AI
APP_ENV=development
SECRET_KEY=change-me-to-a-random-string
IOT_DEVICE_TOKEN=change-me-device-token
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///./ovarian_ai.db

# Prototype presentation thresholds (not clinically validated)
RISK_LOW_THRESHOLD=0.30
RISK_HIGH_THRESHOLD=0.70

HOST=0.0.0.0
PORT=5000
